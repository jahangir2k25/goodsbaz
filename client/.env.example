# Leave empty in development (Vite proxies /api to http://localhost:5000)
# In production set the full API url, e.g. https://api.yoursite.com/api
VITE_API_URL=
# Google Cloud OAuth 2.0 Web client ID (also set as GOOGLE_CLIENT_ID in server/.env)
VITE_GOOGLE_CLIENT_ID=

